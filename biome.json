{
  "$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": false
  },
  "files": {
    "includes": [
      "**",
      "!.next",
      "!out",
      "!build",
      "!dist",
      "!coverage",
      "!node_modules",
      "!next-env.d.ts",
      "!**/*.css",
      "!**/fixtures",
      "!**/__fixtures__",
      "!**/*.svelte",
      "!**/*.vue",
      "!**/public",
      "!**/wasm",
      "!**/*.svg",
      "!**/*.html"
    ]
  },
  "formatter": {
    "enabled": true,
    "lineWidth": 100,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "noNoninteractiveElementInteractions": "error",
        "noStaticElementInteractions": "error",
        "useKeyWithClickEvents": "error"
      },
      "style": {
        "noNonNullAssertion": "warn"
      },
      "suspicious": {
        "noArrayIndexKey": "warn",
        "noConsole": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "semicolons": "always",
      "quoteStyle": "single",
      "trailingCommas": "es5",
      "arrowParentheses": "asNeeded"
    }
  },
  "overrides": [
    {
      "includes": ["scripts/**", "tools/**", "**/*.config.*", "**/*.mjs"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**/__tests__/**",
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.spec.ts",
        "**/*.spec.tsx"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "useHookAtTopLevel": "off"
          },
          "suspicious": {
            "noExplicitAny": "off",
            "noConsole": "off",
            "useIterableCallbackReturn": "off",
            "noNonNullAssertedOptionalChain": "off",
            "noTemplateCurlyInString": "off"
          },
          "style": {
            "noNonNullAssertion": "off"
          },
          "a11y": {
            "noNoninteractiveElementInteractions": "off",
            "noStaticElementInteractions": "off",
            "useKeyWithClickEvents": "off",
            "useSemanticElements": "off",
            "useButtonType": "off"
          }
        }
      }
    }
  ]
}
